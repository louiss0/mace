{
  "abiMajor": 1,
  "library": "mace_processor",
  "unsupported": {
    "linux-amd64-musl": "Unsupported by the released Go c-shared runtime. See README.md#musl-support.",
    "linux-arm64-musl": "Unsupported by the released Go c-shared runtime. See README.md#musl-support.",
    "windows-arm64": "The windows-11-arm runner has no aarch64 mingw sysroot, so cgo cannot find stdlib.h for a cross build. Needs a cross toolchain."
  },
  "targets": [
    {
      "target": "darwin-amd64",
      "goos": "darwin",
      "goarch": "amd64",
      "libc": "system",
      "runner": "macos-15-intel",
      "filename": "libmace_processor.dylib"
    },
    {
      "target": "darwin-arm64",
      "goos": "darwin",
      "goarch": "arm64",
      "libc": "system",
      "runner": "macos-14",
      "filename": "libmace_processor.dylib"
    },
    {
      "target": "windows-amd64",
      "goos": "windows",
      "goarch": "amd64",
      "libc": "system",
      "runner": "windows-2022",
      "filename": "mace_processor.dll"
    },
    {
      "target": "linux-amd64-glibc",
      "goos": "linux",
      "goarch": "amd64",
      "libc": "glibc",
      "runner": "ubuntu-24.04",
      "filename": "libmace_processor.so"
    },
    {
      "target": "linux-arm64-glibc",
      "goos": "linux",
      "goarch": "arm64",
      "libc": "glibc",
      "runner": "ubuntu-24.04-arm",
      "filename": "libmace_processor.so"
    }
  ]
}
