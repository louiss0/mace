|============================================================================================================|
alias StringValue: variant[string, choice["alpha", "beta"]];
alias IntValue: variant[int, choice[1, 2]];
alias FloatValue: variant[float, choice[1.5, 2.5]];
alias BooleanValue: variant[boolean, choice[true, false]];
alias HexIntValue: variant[hex_int, choice[0x1, 0x2]];
alias HexFloatValue: variant[hex_float, choice[0x1.0, 0x2.0]];
alias ChoiceValue: choice[1, 2, 3, 4, 5, 6];

alias LiteralString: choice["alpha"];
alias LiteralInt: choice[1];
alias LiteralFloat: choice[1.5];
alias LiteralBoolean: choice[true];
alias LiteralHexInt: choice[0xA];
alias LiteralHexFloat: choice[0x1.8];

alias ArrayVariant: variant[array<string>, array<int>];
alias ArrayNest1: variant[array<string>, array<array<string>>];
alias ArrayNest2: variant[array<array<string>>, array<array<array<string>>>];
alias ArrayNest3: variant[array<array<array<string>>>, array<array<array<array<string>>>>];
alias ArrayNest4: variant[array<array<array<array<string>>>>, array<array<array<array<array<string>>>>>];
alias ArrayNest5: variant[array<array<array<array<array<string>>>>>, array<array<array<array<array<int>>>>>];

alias SchemaPair: variant[User, Team];
alias OptionalSchemaPair: variant[PrimaryUser, SecondaryUser];

schema User: {
  name: string,
  status: Status,
};

schema Team: {
  name: string,
  size: int,
};

schema PrimaryUser: {
  id: string,
  nickname?: string,
};

schema SecondaryUser: {
  id: string,
  email?: string,
};

alias Status: choice["Active", "Disabled"];
|============================================================================================================|

[output = 'schema']
{
  string_value: StringValue,
  int_value: IntValue,
  float_value: FloatValue,
  boolean_value: BooleanValue,
  hex_int_value: HexIntValue,
  hex_float_value: HexFloatValue,
  choice_value: ChoiceValue,
  literal_string: LiteralString,
  literal_int: LiteralInt,
  literal_float: LiteralFloat,
  literal_boolean: LiteralBoolean,
  literal_hex_int: LiteralHexInt,
  literal_hex_float: LiteralHexFloat,
  array_variant: ArrayVariant,
  schema_pair: SchemaPair,
  optional_schema_pair: OptionalSchemaPair,
}
