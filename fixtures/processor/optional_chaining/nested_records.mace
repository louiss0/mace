string fallback = "missing";
|===================================================|

[output = 'data']
{
  present: packages?.codefixer?.cn_efs ?? fallback,
  missing: packages?.codefixer?.missing ?? fallback,
  wrong_depth2: packages_at_depth_1?.foo?.bar,
  wrong_depth3: packages_at_depth_2?.foo?.bar?.beep,
  wrong_depth4: packages_at_depth_3?.foo?.bar?.beep?.boop,
  wrong_depth5: packages_at_depth_4?.foo?.bar?.beep?.boop?.bam,
  wrong_depth6: packages_at_depth_5?.foo?.bar?.beep?.boop?.bam?.eeep,
  wrong_depth7: packages_at_depth_6?.foo?.bar?.beep?.boop?.bam?.eeep?.ops,
  wrong_depth8: packages_at_depth_7?.foo?.bar?.beep?.boop?.bam?.eeep?.ops?.e4,
  wrong_depth9: packages_at_depth_8?.foo?.bar?.beep?.boop?.bam?.eeep?.ops?.e4?.er,
  wrong_depth10: packages_at_depth_9?.foo?.bar?.beep?.boop?.bam?.eeep?.ops?.e4?.er?.w,
