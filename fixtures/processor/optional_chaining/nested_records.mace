PackagesAtDepth1 packages_at_depth_1 = {foo: "val"};
PackagesAtDepth2 packages_at_depth_2 = {foo: {foo: "val"}};
PackagesAtDepth3 packages_at_depth_3 = {foo: {foo: {foo: "val"}}};
PackagesAtDepth4 packages_at_depth_4 = {foo: {foo: {foo: {foo: "val"}}}};
PackagesAtDepth5 packages_at_depth_5 = {foo: {foo: {foo: {foo: {foo: "val"}}}}};
PackagesAtDepth6 packages_at_depth_6 = {foo: {foo: {foo: {foo: {foo: {foo: "val"}}}}}};
PackagesAtDepth7 packages_at_depth_7 = {foo: {foo: {foo: {foo: {foo: {foo: {foo: "val"}}}}}}};
