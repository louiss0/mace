|===================================================|
record<record<string>> packages = {
  codefixer: { cn_efs: "enabled", },
};
alias PackagesAtDepth1: variant[record<string>, record<record<string>>];
alias PackagesAtDepth2: variant[record<record<string>>, record<record<record<string>>>];
alias PackagesAtDepth3: variant[record<record<record<string>>>, record<record<record<record<string>>>>];
alias PackagesAtDepth4: variant[record<record<record<record<string>>>>, record<record<record<record<record<string>>>>>];
