|===================================================|
schema Address: {
  city?: string,
};

schema Profile: {
  address: Address,
};

schema User: {
  records: record<string>,
  profile: Profile,
};

nullable User missing_user = null;
nullable User user = {
  records: { primary: "active", },
  profile: { address: { city: "Paris", }, },
};
string fallback = "";



|===================================================|

[output = 'data']
{
  fallback: missing_user ? missing_user.records?.primary ?? "" : "",
  records: user ? user.records : { primary: 'inactive' },
  city: user ? user.profile.address?.city ?? fallback : 3
}
