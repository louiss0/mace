|=======================|
alias UserID: string;
alias TeamSlug: string;
alias Email: string;

schema UserProfile: {
  id: UserID,
  name: string,
  email: Email,
  team: TeamSlug,
};

schema SessionInput: {
  env: string,
  region: string,
  profile: UserProfile,
};


|=======================|
[output = 'schema']
{
  SessionInput: SessionInput,
}
