|===================================================|
schema Address: {
  city: string,
};

schema Profile: {
  address?: Address,
};

schema User: {
  profile?: Profile,
};

User user = { profile: {}, };
string fallback_city = "unknown";
|===================================================|

[output = "data"]
{
  city: user?.profile?.address?.city ?? fallback_city,
  literal_city: user?.profile?.address?.city ?? "unknown",
}
