|==================================================|
alias ReadAction: choice["read"];
alias WriteAction: choice["write", "approve"];
alias Permission: fusion[ReadAction, WriteAction];
alias Role: choice["admin", "auditor"];

schema AccessGrant: {
  role: Role,
  permission: Permission,
  resource: string,
};

AccessGrant grant = {
  role: "admin",
  permission: "approve",
  resource: "invoice",
};
|==================================================|

[output = 'data']
{
  result: grant,
}
