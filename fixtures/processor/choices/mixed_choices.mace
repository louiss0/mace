|==================================================|
alias PrimaryChannel: choice["email", "sms"];
alias SupportChannel: choice["chat", "phone"];
alias ContactChannel: fusion[PrimaryChannel, SupportChannel];

schema ContactPreference: {
  customer_id: string,
  preferred: ContactChannel,
  fallback: ContactChannel,
};

ContactPreference preference = {
  customer_id: "CUST-42",
  preferred: "email",
  fallback: "chat",
};
|==================================================|

[output = 'data']
{
  result: preference,
}
